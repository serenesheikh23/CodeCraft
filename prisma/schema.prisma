generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String
  minPrice    Int
  maxPrice    Int
  features    String
  icon        String
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AddOn {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Int
  icon        String
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String
  problem      String
  solution     String
  outcome      String
  imageUrl     String
  liveUrl      String
  githubUrl    String?
  techStack    String?
  featured     Boolean  @default(false)
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  images       String   @default("[]")
}

model Testimonial {
  id             String   @id @default(cuid())
  clientName     String
  clientRole     String
  clientCompany  String
  content        String
  rating         Int      @default(5)
  avatarUrl      String
  projectId      String?
  order          Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SiteSettings {
  id                String   @id @default("singleton")
  email             String   @default("serenesheikh23@gmail.com")
  phone1            String   @default("+963 933 135 837")
  phone2            String   @default("+963 997 112 295")
  whatsapp1         String   @default("+963933135837")
  whatsapp2         String   @default("+963997112295")
  instagramUrl      String   @default("")
  linkedin1Url      String   @default("")
  linkedin2Url      String   @default("")
  location          String   @default("Remote Worldwide")
  tagline           String   @default("Building ideas into digital products. Websites, apps and full systems.")
  updatedAt         DateTime @updatedAt
}

model FooterLink {
  id        String   @id @default(cuid())
  section   String
  label     String
  href      String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LegalPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String
  updatedAt DateTime @updatedAt
}

model CustomPage {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  content      String
  isActive     Boolean  @default(true)
  isPublished  Boolean  @default(true)
  showInNav    Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

model NavLink {
  id         String   @id @default(cuid())
  label      String
  href       String
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  isExternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PageSection {
  id        String   @id @default(cuid())
  pageId    String
  type      String
  title     String   @default("")
  subtitle  String   @default("")
  content   String   @default("{}")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomepageSection {
  id          String   @id @default(cuid())
  type        String
  name        String   @default("")
  title       String   @default("")
  subtitle    String   @default("")
  content     String   @default("{}")
  order       Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}