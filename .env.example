# ─── Database ─────────────────────────────────────────────────────────────
# Local SQLite (default for development). Comment out when using Turso.
DATABASE_URL=file:./prisma/dev.db

# Turso (libSQL) for production. Leave empty for local-only dev.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── Auth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-32-byte-secret
NEXTAUTH_URL=http://localhost:3000

# ─── Email ────────────────────────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_replace_with_your_resend_api_key
